<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Student</title>
    <link rel="stylesheet" href="/formStyle.css">
</head>
<body>

<div class="form-container">
    <h1>Add New Student</h1>

    <form action="/students" method="POST" id="studentForm">

        <!-- ID -->
        <div class="form-group">
            <label>ID <span class="required-asterisk">*</span></label>
            <div class="input-wrapper">
                <input type="text" id="id" name="id" required>
                <span class="icon"></span>
            </div>
            <small class="error-message"></small>
        </div>

        <!-- Username -->
        <div class="form-group">
            <label>Username <span class="required-asterisk">*</span></label>
            <div class="input-wrapper">
                <input type="text" id="username" name="username" required>
                <span class="icon"></span>
            </div>
            <small class="error-message"></small>
        </div>

        <!-- Email -->
        <div class="form-group">
            <label>Email <span class="required-asterisk">*</span></label>
            <div class="input-wrapper">
                <input type="email" id="email" name="email" required>
                <span class="icon"></span>
            </div>
            <small class="error-message"></small>
        </div>

        <!-- Password -->
        <div class="form-group">
            <label>Password <span class="required-asterisk">*</span></label>
            <div class="input-wrapper">
                <input type="password" id="password" name="password" required>
                <span class="icon"></span>
            </div>

            <!-- Strength meter -->
            <div class="strength-bar">
                <div id="strength-fill"></div>
            </div>
            <small id="strength-text"></small>

            <small class="error-message"></small>
        </div>

        <button type="submit" id="submitBtn" disabled>Submit</button>
    </form>
</div>

<script src="/app.js"></script>
</body>
</html>